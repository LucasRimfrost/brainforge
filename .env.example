DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=brainforge

DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8080

# Rate limiting: take the client IP from X-Forwarded-For / X-Real-IP / Forwarded?
# Leave false unless the app sits behind a reverse proxy (nginx, Caddy, a cloud
# load balancer) that OVERWRITES those headers. If clients can reach the app
# directly, they can fake a new IP per request and bypass login rate limits.
# Behind such a proxy set it to true, or every client shares the proxy's IP.
TRUST_PROXY_HEADERS=false
# Only used when TRUST_PROXY_HEADERS=true. The client IP is the X-Forwarded-For
# entry TRUSTED_PROXY_HOPS places from the right (1 = the entry added by the
# proxy in front of the app); anything further left is client-supplied.
# TRUSTED_PROXY_HOPS=1
# Optional comma-separated CIDRs/IPs of your proxies. If set, proxy headers are
# ignored on connections from any other address. Empty = trust any peer.
# TRUSTED_PROXY_CIDRS=10.0.0.0/8

RUST_LOG=debug,api=debug,tower_http=debug,tower_governor=info,sqlx=warn

SESSION_EXPIRY_DAYS=30

# Database pool and timeouts (defaults shown). Keep DB_MAX_CONNECTIONS x number
# of app instances below Postgres max_connections.
# DB_MAX_CONNECTIONS=10
# DB_MIN_CONNECTIONS=2
# Per-statement limit in ms (includes lock waits); 0 disables. Migrations are
# run on a separate connection without this limit.
# DB_STATEMENT_TIMEOUT_MS=5000
# Requests taking longer than this get a 503.
# REQUEST_TIMEOUT_SECS=10

SQLX_OFFLINE=true
