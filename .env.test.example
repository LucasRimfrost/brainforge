DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=brainforge_test

DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

BACKEND_HOST=127.0.0.1
BACKEND_PORT=0

# Rate limiting: take the client IP from X-Forwarded-For / X-Real-IP / Forwarded?
# Leave false unless the app sits behind a reverse proxy (nginx, Caddy, a cloud
# load balancer) that OVERWRITES those headers. If clients can reach the app
# directly, they can fake a new IP per request and bypass login rate limits.
# Behind such a proxy set it to true, or every client shares the proxy's IP.
TRUST_PROXY_HEADERS=false

JWT_SECRET=test-secret-key-for-integration-tests
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=15

REFRESH_TOKEN_EXPIRY_DAYS=7
